<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_150sdp"
    android:layout_margin="@dimen/_5sdp">

    <!-- Background image -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/note_bg_1" />

    <!-- Dark scrim overlay — visible on premium items so the crown stands out -->
    <View
        android:id="@+id/v_premium_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Premium crown badge — top-end corner -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_premium_lock"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/_6sdp"
        android:padding="@dimen/_4sdp"
        app:srcCompat="@drawable/ic_premium"
        android:visibility="gone" />

</FrameLayout>