<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_exit_simple.xml
    Matches design: "Exit App?" — Variant A (Simple / Transparent Modal)
    Image ref: Modal_Variant_A__Friendly___Transparent.png

    Layout:
      - White card, large rounded corners, NO close button
      - Title: "Exit App?" bold, centered
      - Body: "Are you sure you want to leave Daily Journal?" gray, centered
      - [Stay]  — filled teal pill, full-width (PRIMARY)
      - [Exit]  — outlined white pill, full-width, lighter border
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="32dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/exit_app"
                android:fontFamily="@font/outfit_bold"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="12dp" />

            <!-- Body -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/are_you_sure_you_want_to_leave_ndaily_journal"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_regular"
                android:textColor="#777777"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="32dp" />

            <!-- Stay button — filled teal (PRIMARY per design) -->
            <Button
                android:id="@+id/btnStayInApp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:text="@string/stay"
                android:textAllCaps="false"
                android:fontFamily="@font/outfit_bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/app_primary_color"
                android:stateListAnimator="@null"
                app:cornerRadius="26dp"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Exit button — light outlined / white -->
            <Button
                android:id="@+id/btnExitApp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/exit"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="#555555"
                android:fontFamily="@font/outfit_bold"
                android:backgroundTint="#FFFFFF"
                android:stateListAnimator="@null"
                app:cornerRadius="26dp"
                app:strokeColor="@color/app_primary_color"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>