<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_internet_connectivity.xml
    Matches design: "Stay Connected for Better Experience"

    Changes from v1:
      • Added ivClose (X / close icon) in a header row at the top of the card.
        Tapping it = dismiss for session (same as back press).
      • paddingTop reduced from 36dp → 12dp because the header row now
        provides visual breathing room at the top.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="50dp"
    android:layout_marginEnd="50dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">

            <!-- ── Header: X button anchored to the end ───────────────────── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivClose"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Close"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#AAAAAA" />

            </RelativeLayout>

            <!-- Teal WiFi/signal icon -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wifi_signal"
                    android:contentDescription="WiFi signal" />

            </FrameLayout>

            <!-- Title — teal, bold -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/outfit_bold"
                android:text="Stay Connected for\nBetter Experience"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3AACBA"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp" />

            <!-- Body text — dark gray, centered -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Turning on internet improves app\nperformance. Some features may\ninclude ads to support the app."
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingMultiplier="1.45"
                android:layout_marginBottom="28dp" />

            <!-- Primary button: Turn On Internet — filled teal pill -->
            <Button
                android:id="@+id/btnCheckConnectivity"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:text="Turn On Internet"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="normal"
                android:backgroundTint="@color/app_primary_color"
                android:stateListAnimator="@null"
                app:cornerRadius="26dp"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Secondary button: Remind Me Later — light teal/muted pill -->
            <Button
                android:id="@+id/btnRemindLater"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Remind Me Later"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="@color/app_primary_color"
                android:backgroundTint="#D6EEF1"
                android:stateListAnimator="@null"
                app:cornerRadius="26dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>