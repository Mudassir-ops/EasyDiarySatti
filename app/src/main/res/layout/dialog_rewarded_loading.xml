<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_rewarded_loading.xml
    Matches the "Almost Ready" popup design from the screenshot.
    Used by RewardedLoadingDialog — shown while the rewarded video ad loads.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#40C8E8F4">

    <!-- Outer card (light blue tinted, matches screenshot blurred card) -->


        <!-- Inner white card -->
        <androidx.cardview.widget.CardView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="32dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <!-- Gift / reward icon in teal circle -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp">

                    <!-- Circle background -->
                    <View
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/rewarded_icon_bg" />

                    <!-- Icon -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gift_reward"
                        app:tint="@color/app_primary_color" />
                </FrameLayout>

                <!-- "Preparing your reward..." title -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvLoadingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:text="@string/rewarded_loading_title"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp" />

                <!-- Subtitle -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvLoadingSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/outfit"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/rewarded_loading_subtitle"
                    android:textColor="#888888"
                    android:textSize="@dimen/_13ssp" />

                <!-- Animated loading dots -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <View
                        android:id="@+id/dot1"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/loading_dot_active" />

                    <View
                        android:id="@+id/dot2"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/loading_dot_inactive" />

                    <View
                        android:id="@+id/dot3"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/loading_dot_inactive" />

                    <View
                        android:id="@+id/dot4"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/loading_dot_inactive" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>


</FrameLayout>