<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_save_as_draft.xml
    Matches design: "Save your note before leaving?"
    Image ref: Unsaved_Note_Popups.png

    Layout:
      - White card, large rounded corners
      - Top: teal document/pencil icon in soft teal circle
      - Title: "Save your note before leaving?" bold, dark, centered
      - Body: "You have unsaved changes in this note. What would you like to do?" gray, centered
      - [Save as Draft] — filled teal pill
      - [Cancel]        — outlined white pill, light border
      - "Exit Anyway"   — red/coral text link centered (NO underline per design, just red color)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="32dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp">

            <!-- Document + pencil icon in soft teal circle -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_teal_light" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/draft_ic"
                    android:contentDescription="Draft document"
                    />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/don_t_lose_your_thoughts"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="10dp" />

            <!-- Body -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/your_note_isn_t_saved_yet_would_you_like_nto_keep_it"
                android:textSize="13sp"
                android:textColor="#777777"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="28dp" />

            <!-- Save as Draft — filled teal pill (PRIMARY) -->

            <!-- Cancel — outlined white pill -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAsDraft"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/app_primary_color"
                android:gravity="center"
                android:text="@string/save_as_draft"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="26dp"
                app:icon="@drawable/spark_ic"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="20dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="@string/keep_editing"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="#1C4857"
                android:backgroundTint="#D9EEF6"
                android:stateListAnimator="@null"
                app:cornerRadius="26dp"
               />

            <!-- Exit Anyway — red/coral text, no underline per design -->
            <TextView
                android:id="@+id/tvExitAnyway"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back_to_home"
                android:textSize="14sp"
                android:textColor="#1C4857"
                android:textStyle="normal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>