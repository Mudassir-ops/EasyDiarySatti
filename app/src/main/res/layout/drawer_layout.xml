<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintEnd_toStartOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_onGoing_item_label_1"
        app:srcCompat="@drawable/back_icon"
        app:tint="@color/drawer_color" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_onGoing_item_label_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:elevation="@dimen/_5sdp"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/profile_settings"
        android:textAlignment="center"
        android:textColor="@color/drawer_color"
        android:textSize="@dimen/_16ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_edit_profile"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginEnd="-15dp"
        android:elevation="@dimen/_5sdp"
        android:scaleType="fitXY"
        android:background="@drawable/circle_bg"
        app:layout_constraintEnd_toEndOf="@id/profile_layout"
        app:layout_constraintTop_toTopOf="@id/profile_layout"
        app:srcCompat="@drawable/edit_icon" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="0dp"
        android:scaleType="fitXY"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/profile_layout"
        app:layout_constraintEnd_toEndOf="@+id/profile_layout"
        app:layout_constraintStart_toStartOf="@+id/profile_layout"
        app:layout_constraintTop_toTopOf="@+id/profile_layout"
        app:shapeAppearanceOverlay="@style/FullCircleShape"
        app:srcCompat="@drawable/theme_1"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_layout"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:layout_marginVertical="@dimen/_20sdp"
        android:background="@drawable/drawer_bg_shape"
        app:layout_constraintEnd_toEndOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintStart_toStartOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintTop_toBottomOf="@+id/tv_onGoing_item_label_1">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPlacHolder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/_15sdp"
            android:elevation="@dimen/_5sdp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_person_svg"
           />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:elevation="@dimen/_5sdp"
        android:fontFamily="@font/outfit_semibold"
        android:text="@string/satti"
        android:textAlignment="center"
        android:textSize="@dimen/_15ssp"
        app:layout_constraintEnd_toEndOf="@id/profile_layout"
        app:layout_constraintStart_toStartOf="@id/profile_layout"
        app:layout_constraintTop_toBottomOf="@+id/profile_layout" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/labelAccountSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:elevation="@dimen/_5sdp"
        android:fontFamily="@font/outfit_semibold"
        android:text="@string/account_settings"
        android:textAlignment="center"
        android:textColor="@color/drawer_color"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintStart_toStartOf="@+id/iv_back"
        app:layout_constraintTop_toBottomOf="@+id/tvName" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawerItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/_20sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/labelAccountSettings"
        app:layout_constraintTop_toBottomOf="@+id/labelAccountSettings"
        tools:listitem="@layout/drawer_item_layout" />

</androidx.constraintlayout.widget.ConstraintLayout>