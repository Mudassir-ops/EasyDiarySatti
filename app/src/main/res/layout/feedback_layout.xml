<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_margin="@dimen/_10sdp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/iv_close" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_onGoing_item_label_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/love_easy_diary"
        android:textAlignment="center"
        android:textColor="@color/app_primary_color"
        android:textSize="@dimen/_16ssp"
        app:layout_constraintBottom_toBottomOf="@+id/ivClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivClose" />

    <View
        android:id="@+id/view_horizontal_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@color/app_primary_color"
        app:layout_constraintEnd_toEndOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintStart_toStartOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintTop_toBottomOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintWidth_percent="0.85" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:fontFamily="@font/outfit"
        android:text="@string/your_feedback_helps_us"
        android:textAlignment="center"
        android:textColor="#49454F"
        android:textSize="@dimen/_13ssp"
        app:layout_constraintEnd_toEndOf="@+id/view_horizontal_line"
        app:layout_constraintStart_toStartOf="@+id/view_horizontal_line"
        app:layout_constraintTop_toBottomOf="@+id/view_horizontal_line" />

    <androidx.appcompat.widget.AppCompatRatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_15sdp"
        android:background="@null"
        android:backgroundTint="@android:color/transparent"
        android:layoutDirection="ltr"
        android:max="5"
        android:numStars="5"
        android:progress="1"
        android:progressBackgroundTint="@color/app_color"
        android:progressTint="@color/app_primary_color"
        android:secondaryProgressTint="@color/app_color"
        android:stepSize="1"
        app:layout_constraintBottom_toTopOf="@+id/btnCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/cancel"
        android:textColor="@color/app_primary_color"
        android:textSize="@dimen/_14ssp"
        app:backgroundTint="@color/white"
        app:cornerRadius="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDone"
        app:layout_constraintStart_toStartOf="@+id/view_horizontal_line"
        app:layout_constraintTop_toBottomOf="@+id/ratingBar"
        app:rippleColor="@color/app_primary_color"
        app:strokeColor="@color/app_primary_color"
        app:strokeWidth="@dimen/_1sdp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone"
        android:layout_width="0dp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginStart="@dimen/_7sdp"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/done"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        app:backgroundTint="@color/app_primary_color"
        app:cornerRadius="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="@+id/btnCancel"
        app:layout_constraintEnd_toEndOf="@+id/view_horizontal_line"
        app:layout_constraintStart_toEndOf="@+id/btnCancel"
        app:layout_constraintTop_toTopOf="@+id/btnCancel"
        app:rippleColor="@color/app_color" />

</androidx.constraintlayout.widget.ConstraintLayout>
