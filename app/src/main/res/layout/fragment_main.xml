<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/theme_1"
    tools:context=".ui.main.MainFragment">


    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="@dimen/_60sdp"
        android:background="@android:color/white"
        android:backgroundTint="@null"
        android:clipChildren="false"
        android:gravity="center"
        android:padding="8dp"
        app:innerCornerSize="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_5sdp"
            android:fontFamily="@font/outfit_medium"
            android:insetRight="@dimen/_5sdp"
            android:text="@string/title_home"
            android:textColor="@color/selector_nav_text"
            android:textSize="@dimen/_8ssp"
            app:backgroundTint="@color/selector_nav_background"
            app:icon="@drawable/home_menu"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/selector_nav_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.85" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_library"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_5sdp"
            android:fontFamily="@font/outfit_medium"
            android:insetRight="@dimen/_5sdp"
            android:text="@string/library"
            android:textColor="@color/selector_nav_text"
            android:textSize="@dimen/_8ssp"
            app:backgroundTint="@color/selector_nav_background"
            app:cornerRadius="@dimen/_20sdp"
            app:icon="@drawable/reading"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/selector_nav_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.85" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_calendar"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_5sdp"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/calender"
            android:textColor="@color/selector_nav_text"
            android:textSize="@dimen/_8ssp"
            app:backgroundTint="@color/selector_nav_background"
            app:icon="@drawable/home_menu"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/selector_nav_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.85" />

    </com.google.android.material.button.MaterialButtonToggleGroup>


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_activity_main2"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/mobile_navigation2" />

</androidx.constraintlayout.widget.ConstraintLayout>