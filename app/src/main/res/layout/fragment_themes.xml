<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnBack"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_margin="@dimen/_20sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_icon" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:fontFamily="@font/outfit_bold"
        android:text="@string/choose_your_theme"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        android:textSize="@dimen/_20ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/outfit"
        android:text="@string/choose_a_theme_that_reflects_your_personality_nand_enhances_your_diary_experience"
        android:textAlignment="viewStart"
        android:textColor="@color/txt_color_gray"
        android:textSize="@dimen/_13ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/themeViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginVertical="@dimen/_20sdp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_45sdp"
        app:layout_constraintBottom_toTopOf="@+id/btnLater"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLater"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_40sdp"
        android:background="@drawable/btn_theme_unselected_bg_shape"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/later"
        android:elevation="@dimen/_4sdp"
        android:textAllCaps="false"
        android:textColor="@color/app_primary_color"
        android:textSize="@dimen/_13ssp"

        app:elevation="@dimen/_2sdp"
        app:backgroundTint="@color/white"

        app:strokeColor="@color/grey"
        app:strokeWidth="@dimen/_1sdp"
        app:cornerRadius="@dimen/_3sdp"

        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSelect"
        app:layout_constraintHeight_percent="0.06"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_20sdp"
        android:background="@drawable/btn_theme_bg_shape"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/select"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="@dimen/_13ssp"
        app:backgroundTint="@null"
        app:cornerRadius="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@+id/btnLater"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnLater"
        app:layout_constraintTop_toTopOf="@+id/btnLater" />

</androidx.constraintlayout.widget.ConstraintLayout>
