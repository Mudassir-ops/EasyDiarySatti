<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_5sdp"
    android:layout_marginHorizontal="@dimen/_5sdp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Chip pill — full width, selector on THIS view so isSelected triggers teal -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTagChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tag_chip_selector"
        android:ellipsize="end"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:textColor="@color/tag_chip_text_selector"
        android:textSize="@dimen/_13ssp" />

    <!-- × badge — overlaps chip at top-right corner.
         Starts GONE; adapter sets VISIBLE on selected/manage-mode chips. -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_delete_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        android:padding="4dp"
        android:scaleType="fitXY"
        android:src="@drawable/cross_ic"

        android:visibility="visible"
        app:tint="#7A7A7A" />

</FrameLayout>