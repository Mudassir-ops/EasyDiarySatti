<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="noteEntity"
            type="com.example.easydiarysatti.data.local.CreateNoteEntity" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoot"  android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_8sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="@dimen/_4sdp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_swipe_fav"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="#E8BA00"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:srcCompat="@drawable/fav_ic"
                     />
            </LinearLayout>

            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>

            <LinearLayout
                android:id="@+id/btn_swipe_delete"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="#E80200"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:srcCompat="@drawable/delete_ic"
                    />
            </LinearLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/view_foreground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F1F5F9"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_15sdp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_note_header"
                capitalizeFirst="@{noteEntity.title}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textSize="@dimen/_16ssp"
                android:textColor="#475569"
                android:maxLines="1"
                app:layout_constraintEnd_toStartOf="@+id/tv_not_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                 />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_note_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/outfit"
                android:maxLines="2"
                android:visibility="gone"
                android:text="@{noteEntity.description}"
                android:textAlignment="viewStart"
                android:textColor="@color/tag_txt_color"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintEnd_toStartOf="@+id/tv_not_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_note_header" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_not_time"
                formattedTime="@{noteEntity.creationTime}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_5sdp"
                android:fontFamily="@font/outfit"
                android:textAlignment="center"
                android:textColor="@color/tag_txt_color"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_note_header"
                app:layout_constraintEnd_toStartOf="@id/iv_more_options"
                app:layout_constraintStart_toEndOf="@+id/tv_note_header"
                app:layout_constraintTop_toTopOf="@+id/tv_note_header" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_more_options"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/kabab"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/tag_txt_color" />
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:constraint_referenced_ids="tv_tag,tv_feeling"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="@dimen/_8sdp"
                app:flow_horizontalStyle="packed"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toStartOf="@+id/iv_favorite_indicator"
                app:layout_constraintStart_toStartOf="@+id/tv_note_header"
                app:layout_constraintTop_toBottomOf="@+id/tv_note_header" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/bg_note_item"
                android:drawablePadding="@dimen/_5sdp"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center"
                android:visibility="@{noteEntity.tags == null || noteEntity.tags.isEmpty() ? View.GONE : View.VISIBLE}"
                android:paddingVertical="@dimen/_5sdp"
                firstTagText="@{noteEntity.tags}"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:textColor="@color/tag_txt_color"
                android:textSize="@dimen/_11ssp"
                app:drawableStartCompat="@drawable/tag_ic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_note_header"
                app:layout_constraintTop_toBottomOf="@+id/tv_note_header"
                app:noteBgFillColor="@{noteEntity.tagColor}"
                app:noteBgStrokeColor="@{noteEntity.tagColor}" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_feeling"
                drawableStartCompat="@{noteEntity.feelingEmojiRes}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:background="@drawable/bg_note_item"
                android:drawablePadding="@dimen/_5sdp"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center"
                android:paddingVertical="@dimen/_5sdp"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:text="@{noteEntity.feelingTitle}"
                android:textColor="@color/tag_txt_color"
                android:textSize="@dimen/_11ssp"
                app:drawableHeightDp="@{18f}"
                app:drawableWidthDp="@{18f}"
                app:layout_constraintBottom_toBottomOf="@+id/tv_tag"
                app:layout_constraintStart_toEndOf="@+id/tv_tag"
                app:layout_constraintTop_toTopOf="@+id/tv_tag"
                app:noteBgFillColor="@{noteEntity.selectedEmojiColor}"
                app:noteBgStrokeColor="@{noteEntity.selectedEmojiColor}" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_favorite_indicator"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginEnd="5dp"
                android:src="@{noteEntity.favorite ? @drawable/ic_heart_filled : @drawable/ic_heart_outline}"
                android:tint="@{noteEntity.favorite ? @color/amber : @color/tag_txt_color}"
                app:layout_constraintBottom_toBottomOf="@+id/iv_gallery"
                app:layout_constraintEnd_toStartOf="@+id/iv_gallery"
                app:layout_constraintTop_toTopOf="@+id/iv_gallery" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_gallery"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_tag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_tag"
                app:showIfHasImages="@{noteEntity.images}"
                app:srcCompat="@drawable/create_note_media_icon"
                app:tint="@color/tag_txt_color" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</layout>