<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_margin="@dimen/_10sdp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/iv_close" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_onGoing_item_label_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_medium"
        android:text="@string/upload_picture"
        android:textAlignment="center"
        android:textColor="@color/app_primary_color"
        android:textSize="@dimen/_16ssp"
        app:layout_constraintBottom_toBottomOf="@+id/ivClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivClose" />

    <View
        android:id="@+id/view_horizontal_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@color/app_primary_color"
        app:layout_constraintEnd_toEndOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintStart_toStartOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintTop_toBottomOf="@+id/tv_onGoing_item_label_1"
        app:layout_constraintWidth_percent="0.85" />

    <View
        android:id="@+id/viewGallery"
        android:layout_width="0dp"
        android:layout_height="@dimen/_45sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/bg_photo_pick"
        app:layout_constraintEnd_toEndOf="@id/view_horizontal_line"
        app:layout_constraintStart_toStartOf="@id/view_horizontal_line"
        app:layout_constraintTop_toBottomOf="@id/view_horizontal_line" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icAudio"
        android:layout_width="@dimen/_27sdp"
        android:layout_height="@dimen/_27sdp"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@id/viewGallery"
        app:layout_constraintEnd_toStartOf="@id/txtRecordAudio"
        app:layout_constraintStart_toStartOf="@id/viewGallery"
        app:layout_constraintTop_toTopOf="@id/viewGallery"
        app:srcCompat="@drawable/iv_gallery_pick" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtRecordAudio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/outfit"
        android:text="@string/upload_from_gallery"
        android:textColor="@color/tag_txt_color"
        app:layout_constraintBottom_toBottomOf="@id/icAudio"
        app:layout_constraintEnd_toEndOf="@id/viewGallery"
        app:layout_constraintStart_toEndOf="@id/icAudio"
        app:layout_constraintTop_toTopOf="@id/icAudio" />

    <View
        android:id="@+id/viewCamera"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:background="@drawable/bg_photo_pick"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/view_horizontal_line"
        app:layout_constraintStart_toStartOf="@id/view_horizontal_line"
        app:layout_constraintTop_toBottomOf="@id/viewGallery" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icMusic"
        android:layout_width="@dimen/_27sdp"
        android:layout_height="@dimen/_27sdp"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="@id/viewCamera"
        app:layout_constraintEnd_toStartOf="@id/txtRecordMusic"
        app:layout_constraintStart_toStartOf="@id/viewCamera"
        app:layout_constraintTop_toTopOf="@id/viewCamera"
        app:srcCompat="@drawable/camera_pick" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtRecordMusic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/outfit"
        android:text="Take a Photo"
        android:textColor="@color/tag_txt_color"
        app:layout_constraintBottom_toBottomOf="@id/icMusic"
        app:layout_constraintEnd_toEndOf="@id/viewCamera"
        app:layout_constraintStart_toEndOf="@id/icMusic"
        app:layout_constraintTop_toTopOf="@id/icMusic" />

</androidx.constraintlayout.widget.ConstraintLayout>