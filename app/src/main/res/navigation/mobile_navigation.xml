            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_mainFragment_to_addTagsFragment2"
            app:destination="@id/addTagsFragment2" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.easydiarysatti.ui.editprofile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile" />
    <fragment
        android:id="@+id/editTagsFragment"
        android:name="com.example.easydiarysatti.ui.edittags.EditFragment"
