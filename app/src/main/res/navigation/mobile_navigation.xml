    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.easydiarysatti.ui.signup.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_themesFragment"
            app:destination="@id/themesFragment" />
        <!--        <action-->
        <!--            android:id="@+id/action_signUpFragment_to_languageFragment"-->
        <!--            app:destination="@id/languageFragment" />-->
    </fragment>
    <fragment
        android:id="@+id/nameFragment"
        android:name="com.example.easydiarysatti.ui.name.NameFragment"
        android:label="NameFragment"
        tools:layout="@layout/fragment_name">
        <action
            android:id="@+id/action_nameFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
    </fragment>
    <fragment
        android:id="@+id/themesFragment"
        android:name="com.example.easydiarysatti.ui.theme.ThemesFragment"
        android:label="ThemesFragment"
        tools:layout="@layout/fragment_themes">
        <action
            android:id="@+id/action_themesFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.easydiarysatti.ui.main.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_mainFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_mainFragment_to_editTagsFragment"
            app:destination="@id/editTagsFragment" />
        <action
