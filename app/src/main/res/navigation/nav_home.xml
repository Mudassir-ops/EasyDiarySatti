<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_home"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.easydiarysatti.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_createNotesFragment2"
            app:destination="@id/createNotesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_remainderFragment"
            app:destination="@id/remainderFragment" />
    </fragment>

    <fragment
        android:id="@+id/createNotesFragment"
        android:name="com.example.easydiarysatti.ui.createnote.CreateNotesFragment"
        android:label="fragment_create_notes"
        tools:layout="@layout/fragment_create_notes">
        <action
            android:id="@+id/action_createNotesFragment2_to_addTagsFragment"
            app:destination="@id/addTagsFragment" />
    </fragment>
    <fragment
        android:id="@+id/addTagsFragment"
        android:name="com.example.easydiarysatti.ui.edittags.AddTagsFragment"
        android:label="fragment_add_tags"
        tools:layout="@layout/fragment_add_tags" >
        <action
            android:id="@+id/action_addTagsFragment_to_createNotesFragment"
            app:destination="@id/createNotesFragment" />
    </fragment>
    <fragment
        android:id="@+id/remainderFragment"
        android:name="com.example.easydiarysatti.ui.remainder.RemainderFragment"
        android:label="@string/reminder_intervals"
        tools:layout="@layout/fragment_remainder" />

</navigation>
